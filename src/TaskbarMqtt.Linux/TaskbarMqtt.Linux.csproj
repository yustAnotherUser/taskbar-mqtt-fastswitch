<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>TaskbarMqtt</RootNamespace>
    <AssemblyName>taskbar-mqtt</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>13.0</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Product>Taskbar MQTT Client</Product>
    <Version>1.9.3</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Tmds.DBus.SourceGenerator" Version="0.0.21" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TaskbarMqtt\Config\**\*.cs" LinkBase="Config" />
    <Compile Include="..\TaskbarMqtt\Mqtt\**\*.cs" LinkBase="Mqtt" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\taskbar-mqtt.png" />
    <EmbeddedResource Include="Assets\button-default.ico" />
    <EmbeddedResource Include="Assets\mqtt-icon.png" />
    <EmbeddedResource Include="..\TaskbarMqtt\Assets\app.ico" LinkBase="Assets" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="DBusXml\org.kde.StatusNotifierItem.xml" DBusGeneratorMode="Handler" />
    <AdditionalFiles Include="DBusXml\org.freedesktop.DBus.xml" DBusGeneratorMode="Proxy" />
    <AdditionalFiles Include="DBusXml\org.kde.StatusNotifierWatcher.xml" DBusGeneratorMode="Proxy" />
  </ItemGroup>

</Project>
